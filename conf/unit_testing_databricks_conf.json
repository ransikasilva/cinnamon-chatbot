{
    "run_name": "chml_reservation_chatbot_unit_test",
    "new_cluster": {
        "autoscale": {
            "min_workers": 1,
            "max_workers": 3
        },
        "spark_version": "7.3.x-cpu-ml-scala2.12",
        "spark_conf": {
            "spark.databricks.delta.preview.enabled": "true",
            "spark.driver.maxResultSize": "10g",
            "spark.sql.shuffle.partitions": "800"
        },
        "azure_attributes": {
            "first_on_demand": 0,
            "availability": "ON_DEMAND_AZURE",
            "spot_bid_max_price": -1
        },
        "node_type_id": "Standard_DS3_v2",
        "ssh_public_keys": [],
        "custom_tags": {
            "Clustertype": "ondemand",
            "Usecase": "rescbt",
            "Team": "DS",
            "Requster": "Unit_Test",
            "Type": "dbjob"
        },
        "spark_env_vars": {},
        "enable_elastic_disk": true,
        "cluster_source": "JOB",
        "init_scripts": []
    },
    "libraries": [
        {
            "maven": {
                "coordinates": "com.crealytics:spark-excel_2.12:0.13.6"
            }
        },
        {
            "pypi": {
                "package": "pandas"
            }
        },
        {
            "pypi": {
                "package": "Sphinx"
            }
        },
        {
            "pypi": {
                "package": "coverage"
            }
        },
        {
            "pypi": {
                "package": "xmlrunner"
            }
        }
    ],
    "notebook_task": {
        "notebook_path": "/testing-env-chml_reservation_chatbot/test/run_tests"
    }
}


